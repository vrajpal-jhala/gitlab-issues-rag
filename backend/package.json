{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init:db": "tsx ./scripts/init_db.ts",
    "scrape:issues": "tsx ./scripts/scrape_issues.ts",
