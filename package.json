{
  "name": "gitlab-issues-rag",
  "version": "1.0.0",
  "author": "Vrajpal Jhala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrajpal-jhala/gitlab-issues-rag.git"
  },
  "bugs": {
    "url": "https://github.com/vrajpal-jhala/gitlab-issues-rag/issues"
  },
  "description": "Foundation project for building a RAG pipeline for GitLab issues in JS using langchain",
  "homepage": "https://github.com/vrajpal-jhala/gitlab-issues-rag#readme",
  "keywords": [],
  "license": "ISC",
  "private": true,
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "postinstall": "run-s install:backend install:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "run-p dev:backend dev:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "run-s build:backend build:frontend",
    "preview:backend": "npm --prefix backend run preview",
    "preview:frontend": "npm --prefix frontend run preview",
    "preview": "run-p preview:backend preview:frontend"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5"
  }
}
